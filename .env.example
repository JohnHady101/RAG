# ── Copy to `.env` and fill in secrets. `.env` is gitignored. ──

# Postgres / pgvector
PGVECTOR_HOST=pgvector
PGVECTOR_PORT=5432
PGVECTOR_DB=vectordb
PGVECTOR_USER=myuser
PGVECTOR_PASSWORD=mypassword

# Gemini (required — no default; get one at https://aistudio.google.com/)
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=3072
GENERATION_MODEL=gemini-3.6-flash

# Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Data (absolute path, or path relative to repo root)
RAG_PDF_PATH=data/annualreport-2025.pdf
